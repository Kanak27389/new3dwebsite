# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration for NEXORA AI contact form
# Replace with your Supabase Project URL and Public Anon Key
# In development without keys, NEXORA AI operates in mock mode with verified database schema docs.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
